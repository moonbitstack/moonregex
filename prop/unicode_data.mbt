///|
fn gc_of(name : StringView) -> CharSet? {
  match name {
    "c" => Some(gc_c)
    "other" => Some(gc_c)
    "cc" => Some(gc_cc)
    "cntrl" => Some(gc_cc)
    "control" => Some(gc_cc)
    "cf" => Some(gc_cf)
    "format" => Some(gc_cf)
    "co" => Some(gc_co)
    "privateuse" => Some(gc_co)
    "cs" => Some(gc_cs)
    "surrogate" => Some(gc_cs)
    "l" => Some(gc_l)
    "letter" => Some(gc_l)
    "casedletter" => Some(gc_lc)
    "lc" => Some(gc_lc)
    "ll" => Some(gc_ll)
    "lowercaseletter" => Some(gc_ll)
    "lm" => Some(gc_lm)
    "modifierletter" => Some(gc_lm)
    "lo" => Some(gc_lo)
    "otherletter" => Some(gc_lo)
    "lt" => Some(gc_lt)
    "titlecaseletter" => Some(gc_lt)
    "lu" => Some(gc_lu)
    "uppercaseletter" => Some(gc_lu)
    "combiningmark" => Some(gc_m)
    "m" => Some(gc_m)
    "mark" => Some(gc_m)
    "mc" => Some(gc_mc)
    "spacingmark" => Some(gc_mc)
    "enclosingmark" => Some(gc_me)
    "me" => Some(gc_me)
    "mn" => Some(gc_mn)
    "nonspacingmark" => Some(gc_mn)
    "n" => Some(gc_n)
    "number" => Some(gc_n)
    "decimalnumber" => Some(gc_nd)
    "digit" => Some(gc_nd)
    "nd" => Some(gc_nd)
    "letternumber" => Some(gc_nl)
    "nl" => Some(gc_nl)
    "no" => Some(gc_no)
    "othernumber" => Some(gc_no)
    "p" => Some(gc_p)
    "punct" => Some(gc_p)
    "punctuation" => Some(gc_p)
    "connectorpunctuation" => Some(gc_pc)
    "pc" => Some(gc_pc)
    "dashpunctuation" => Some(gc_pd)
    "pd" => Some(gc_pd)
    "closepunctuation" => Some(gc_pe)
    "pe" => Some(gc_pe)
    "finalpunctuation" => Some(gc_pf)
    "pf" => Some(gc_pf)
    "initialpunctuation" => Some(gc_pi)
    "pi" => Some(gc_pi)
    "otherpunctuation" => Some(gc_po)
    "po" => Some(gc_po)
    "openpunctuation" => Some(gc_ps)
    "ps" => Some(gc_ps)
    "s" => Some(gc_s)
    "symbol" => Some(gc_s)
    "currencysymbol" => Some(gc_sc)
    "sc" => Some(gc_sc)
    "modifiersymbol" => Some(gc_sk)
    "sk" => Some(gc_sk)
    "mathsymbol" => Some(gc_sm)
    "sm" => Some(gc_sm)
    "othersymbol" => Some(gc_so)
    "so" => Some(gc_so)
    "separator" => Some(gc_z)
    "z" => Some(gc_z)
    "lineseparator" => Some(gc_zl)
    "zl" => Some(gc_zl)
    "paragraphseparator" => Some(gc_zp)
    "zp" => Some(gc_zp)
    "spaceseparator" => Some(gc_zs)
    "zs" => Some(gc_zs)
    _ => None
  }
}

