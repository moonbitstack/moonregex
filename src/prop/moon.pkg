// prop: the character sets a pattern is matched against — `\p{…}`, `\w`, `\d`,
// `\s` — and the case folding `(?i)` closes a class under.
//
// The data comes from the Unicode Character Database through the `moonucd`
// packages: this package owns the algebra over code-point sets, not a copy of
// the UCD.
import {
  "moonbitlang/core/debug",
  "moonbitstack/moonucd",
  "moonbitstack/moonucd/block",
  "moonbitstack/moonucd/name",
  "moonbitstack/moonucd/script",
}
