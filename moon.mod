name = "moonbitstack/moonregex"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonregex"

license = "Apache-2.0"

keywords = [ "regex", "re", "ecma262", "unicode", "moonbit" ]

description = "moonregex — regular expressions for MoonBit: Python's re interface, the mrab-regex superset behind it, and the ECMA-262 dialect that JSON Schema and OpenAPI mean."

preferred_target = "wasm-gc"
