  match name {
    "asciihexdigit" => Some(bin_ascii_hex_digit)
    "alphabetic" => Some(bin_alphabetic)
    "bidicontrol" => Some(bin_bidi_control)
    "caseignorable" => Some(bin_case_ignorable)
    "cased" => Some(bin_cased)
    "changeswhencasefolded" => Some(bin_changes_when_casefolded)
    "changeswhenlowercased" => Some(bin_changes_when_lowercased)
    "changeswhenuppercased" => Some(bin_changes_when_uppercased)
    "defaultignorablecodepoint" => Some(bin_default_ignorable_code_point)
    "deprecated" => Some(bin_deprecated)
    "diacritic" => Some(bin_diacritic)
    "emoji" => Some(bin_emoji)
    "emojicomponent" => Some(bin_emoji_component)
    "emojimodifier" => Some(bin_emoji_modifier)
    "emojimodifierbase" => Some(bin_emoji_modifier_base)
    "emojipresentation" => Some(bin_emoji_presentation)
    "extendedpictographic" => Some(bin_extended_pictographic)
    "extender" => Some(bin_extender)
    "hexdigit" => Some(bin_hex_digit)
    "hyphen" => Some(bin_hyphen)
    "idcontinue" => Some(bin_id_continue)
    "idstart" => Some(bin_id_start)
    "ideographic" => Some(bin_ideographic)
    "joincontrol" => Some(bin_join_control)
    "logicalorderexception" => Some(bin_logical_order_exception)
    "lowercase" => Some(bin_lowercase)
    "math" => Some(bin_math)
    "noncharactercodepoint" => Some(bin_noncharacter_code_point)
    "patternsyntax" => Some(bin_pattern_syntax)
    "patternwhitespace" => Some(bin_pattern_white_space)
    "quotationmark" => Some(bin_quotation_mark)
    "radical" => Some(bin_radical)
    "regionalindicator" => Some(bin_regional_indicator)
    "sentenceterminal" => Some(bin_sentence_terminal)
    "softdotted" => Some(bin_soft_dotted)
    "terminalpunctuation" => Some(bin_terminal_punctuation)
    "uppercase" => Some(bin_uppercase)
    "variationselector" => Some(bin_variation_selector)
    "whitespace" => Some(bin_white_space)
    "xidcontinue" => Some(bin_xid_continue)
    "xidstart" => Some(bin_xid_start)
    "alpha" => Some(bin_alphabetic)
    "upper" => Some(bin_uppercase)
    "lower" => Some(bin_lowercase)
    "space" => Some(bin_white_space)
    "iscased" => Some(bin_cased)
    _ => None
  }
}

